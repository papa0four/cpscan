@{
    ExcludeRules = @(
        # Write-Host is appropriate for installer scripts to intentionally 
        # write colored output directly to the console host.
        'PSAvoidUsingWriteHost',

        # SupportsShouldProcess is a module/cmdlet convention. These are
        # standalone installer scripts not intended for programmatic use.
        'PSUseShouldProcessForStateChangingFunctions',

        # BOM encoding is a best practice for PowerShell 5.1 compatibility
        # but poses no active risk in this context. Files should be saved
        # as UTF-8.
        'PSUseBOMForUnicodeEncodedFile'
    )
}